# --- Supabase -------------------------------------------------------------
# Local: os valores saem de `npx supabase status`.
# Produção: Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ignora RLS. NUNCA prefixe com NEXT_PUBLIC_ e nunca use em componente de
# cliente: isso a mandaria para o navegador de todo mundo.
SUPABASE_SERVICE_ROLE_KEY=

# --- Pagamento ------------------------------------------------------------
# `fake` só funciona fora de produção: lib/pagamento/index.ts lança se
# NODE_ENV=production e o gateway ainda for o de mentira. É proposital, para
# que a plataforma nunca aceite matrícula sem cobrar de verdade.
GATEWAY_PAGAMENTO=fake

# --- Site -----------------------------------------------------------------
# Opcional na Vercel: sem isso, lib/env.ts usa o domínio de produção do
# projeto e, em preview, a URL do deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
